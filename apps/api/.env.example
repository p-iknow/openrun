# 이 파일을 .env로 복사해 쓴다. 값은 루트 compose.yaml의 PostgreSQL과 맞춘다.
DATABASE_URL=postgres://openrun:openrun@localhost:5432/openrun
# 공연 이미지(포스터, 상세 이미지) URL은 이 주소와 저장소 안 경로를 합친다. 시드가 스토어의 public/show-images에 이미지를 쓰므로 스토어 주소를 가리킨다.
SHOW_IMAGE_BASE_URL=http://localhost:3001/show-images
# 세션 쿠키 서명(HMAC-SHA256)의 키. 32자 이상의 난수로 둔다. 운영 값은 `openssl rand -base64 32`로 만든다.
AUTH_SECRET=local-dev-auth-secret-change-me-0123456789
# 사용자 세션 쿠키의 Domain. 스토어와 API가 서브도메인으로 나뉘는 배포에서 상위 도메인(예: openrun.example.com)을 적는다.
# 로컬은 둘 다 localhost에서 포트만 달라 쿠키가 그대로 공유되므로 비워 둔다.
COOKIE_DOMAIN=
