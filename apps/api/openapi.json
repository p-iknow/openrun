{
  "openapi": "3.0.0",
  "paths": {
    "/shows": {
      "get": {
        "operationId": "ShowsController_findPage",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "페이지 번호(1부터). 마지막 페이지를 넘으면 오류가 아니라 빈 items로 응답한다.",
            "schema": {
              "default": 1,
              "description": "페이지 번호(1부터). 마지막 페이지를 넘으면 오류가 아니라 빈 items로 응답한다.",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "description": "페이지 크기",
            "schema": {
              "default": 20,
              "description": "페이지 크기",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "공연 제목 검색어. 앞뒤 공백을 지우고, 빈 값이면 검색하지 않는다. 대소문자를 구분하지 않는 부분 일치이며 %, _, \\도 글자 그대로 찾는다. 최대 50자.",
            "schema": {
              "description": "공연 제목 검색어. 앞뒤 공백을 지우고, 빈 값이면 검색하지 않는다. 대소문자를 구분하지 않는 부분 일치이며 %, _, \\도 글자 그대로 찾는다. 최대 50자.",
              "type": "string",
              "maxLength": 50
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "정렬. start_date는 첫 회차 일시가 이른 순(기본), newest는 등록 일시가 늦은 순이다. 정렬값이 같으면 id로 순서를 고정한다.",
            "schema": {
              "default": "start_date",
              "description": "정렬. start_date는 첫 회차 일시가 이른 순(기본), newest는 등록 일시가 늦은 순이다. 정렬값이 같으면 id로 순서를 고정한다.",
              "type": "string",
              "enum": [
                "start_date",
                "newest"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowPageDto"
                }
              }
            }
          },
          "default": {
            "description": "오류(Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": [
          "Shows"
        ]
      }
    }
  },
  "info": {
    "title": "openrun API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Genre": {
        "type": "string",
        "enum": [
          "musical",
          "play",
          "concert",
          "classical_dance",
          "kids_family"
        ],
        "description": "장르"
      },
      "ShowPeriodDto": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "첫 회차의 시작 일시"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "마지막 회차의 시작 일시"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "ShowSalesStatus": {
        "type": "string",
        "enum": [
          "on_sale",
          "upcoming",
          "ended"
        ],
        "description": "공연 판매 상태. 회차마다 판매 중, 판매 예정, 판매 종료 중 하나로 센 뒤 가장 앞선 것을 고른다. 매진인 회차는 판매 중, 취소된 회차는 판매 종료로 센다."
      },
      "ShowSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "공연 ID"
          },
          "title": {
            "type": "string",
            "description": "공연 제목"
          },
          "genre": {
            "description": "장르",
            "allOf": [
              {
                "$ref": "#/components/schemas/Genre"
              }
            ]
          },
          "venueName": {
            "type": "string",
            "description": "공연장 이름"
          },
          "period": {
            "description": "공연 기간",
            "allOf": [
              {
                "$ref": "#/components/schemas/ShowPeriodDto"
              }
            ]
          },
          "salesStatus": {
            "description": "공연 판매 상태. 회차마다 판매 중, 판매 예정, 판매 종료 중 하나로 센 뒤 가장 앞선 것을 고른다. 매진인 회차는 판매 중, 취소된 회차는 판매 종료로 센다.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ShowSalesStatus"
              }
            ]
          },
          "salesOpenAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "판매 예정일 때 가장 이른 판매 오픈 일시. 판매 예정이 아니면 null이다."
          },
          "posterUrl": {
            "type": "string",
            "format": "uri",
            "description": "3:4 포스터 이미지의 완전한 URL"
          }
        },
        "required": [
          "id",
          "title",
          "genre",
          "venueName",
          "period",
          "salesStatus",
          "salesOpenAt",
          "posterUrl"
        ]
      },
      "ShowPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShowSummaryDto"
            }
          },
          "page": {
            "type": "integer",
            "description": "현재 페이지(1부터)"
          },
          "size": {
            "type": "integer",
            "description": "페이지 크기"
          },
          "totalCount": {
            "type": "integer",
            "description": "조건에 맞는 전체 공연 수"
          },
          "totalPages": {
            "type": "integer",
            "description": "전체 페이지 수. 공연이 없으면 0이다."
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalCount",
          "totalPages"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "잘못된 값의 이름"
          },
          "detail": {
            "type": "string",
            "description": "잘못된 이유"
          }
        },
        "required": [
          "field",
          "detail"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "오류 종류 URI",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "HTTP 상태 문구",
            "example": "Not Found"
          },
          "status": {
            "type": "integer",
            "description": "HTTP 상태 코드",
            "example": 404
          },
          "detail": {
            "type": "string",
            "description": "사람이 읽는 설명"
          },
          "code": {
            "type": "string",
            "description": "앱 오류 코드. 클라이언트는 문구 대신 이 값으로 오류를 구분한다.",
            "example": "NOT_FOUND"
          },
          "errors": {
            "description": "검증 오류일 때 필드별 오류",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ]
      }
    }
  }
}
