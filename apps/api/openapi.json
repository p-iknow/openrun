{
  "openapi": "3.0.0",
  "paths": {
    "/shows": {
      "get": {
        "operationId": "ShowsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShowDto"
                  }
                }
              }
            }
          },
          "default": {
            "description": "오류(Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": [
          "Shows"
        ]
      }
    }
  },
  "info": {
    "title": "openrun API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ShowDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "공연 ID"
          },
          "title": {
            "type": "string",
            "description": "공연 제목"
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "잘못된 값의 이름"
          },
          "detail": {
            "type": "string",
            "description": "잘못된 이유"
          }
        },
        "required": [
          "field",
          "detail"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "오류 종류 URI",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "HTTP 상태 문구",
            "example": "Not Found"
          },
          "status": {
            "type": "integer",
            "description": "HTTP 상태 코드",
            "example": 404
          },
          "detail": {
            "type": "string",
            "description": "사람이 읽는 설명"
          },
          "code": {
            "type": "string",
            "description": "앱 오류 코드. 클라이언트는 문구 대신 이 값으로 오류를 구분한다.",
            "example": "NOT_FOUND"
          },
          "errors": {
            "description": "검증 오류일 때 필드별 오류",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ]
      }
    }
  }
}
