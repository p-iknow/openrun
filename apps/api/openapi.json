{
  "openapi": "3.0.0",
  "paths": {
    "/shows": {
      "get": {
        "operationId": "ShowsController_findPage",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShowPageDto"
                }
              }
            }
          },
          "default": {
            "description": "오류(Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "tags": [
          "Shows"
        ]
      }
    }
  },
  "info": {
    "title": "openrun API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Genre": {
        "type": "string",
        "enum": [
          "musical",
          "play",
          "concert",
          "classical_dance",
          "kids_family"
        ],
        "description": "장르"
      },
      "ShowPeriodDto": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "첫 회차의 시작 일시"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "마지막 회차의 시작 일시"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "ShowSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "공연 ID"
          },
          "title": {
            "type": "string",
            "description": "공연 제목"
          },
          "genre": {
            "description": "장르",
            "allOf": [
              {
                "$ref": "#/components/schemas/Genre"
              }
            ]
          },
          "venueName": {
            "type": "string",
            "description": "공연장 이름"
          },
          "period": {
            "description": "공연 기간",
            "allOf": [
              {
                "$ref": "#/components/schemas/ShowPeriodDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "genre",
          "venueName",
          "period"
        ]
      },
      "ShowPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShowSummaryDto"
            }
          },
          "page": {
            "type": "integer",
            "description": "현재 페이지(1부터)"
          },
          "size": {
            "type": "integer",
            "description": "페이지 크기"
          },
          "totalCount": {
            "type": "integer",
            "description": "조건에 맞는 전체 공연 수"
          },
          "totalPages": {
            "type": "integer",
            "description": "전체 페이지 수. 공연이 없으면 0이다."
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalCount",
          "totalPages"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "잘못된 값의 이름"
          },
          "detail": {
            "type": "string",
            "description": "잘못된 이유"
          }
        },
        "required": [
          "field",
          "detail"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "오류 종류 URI",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "HTTP 상태 문구",
            "example": "Not Found"
          },
          "status": {
            "type": "integer",
            "description": "HTTP 상태 코드",
            "example": 404
          },
          "detail": {
            "type": "string",
            "description": "사람이 읽는 설명"
          },
          "code": {
            "type": "string",
            "description": "앱 오류 코드. 클라이언트는 문구 대신 이 값으로 오류를 구분한다.",
            "example": "NOT_FOUND"
          },
          "errors": {
            "description": "검증 오류일 때 필드별 오류",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ]
      }
    }
  }
}
