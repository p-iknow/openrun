# 아래 turbo 작업은 --output-logs=errors-only로 실패한 작업의 로그만 출력한다.

pnpm exec lint-staged

# 코드에서 openapi.json을 다시 만들고, 스테이징된 파일과 다르면 커밋을 막는다.
pnpm openapi:generate --output-logs=errors-only
if ! git diff --quiet -- apps/api/openapi.json; then
  echo 'apps/api/openapi.json이 API 코드와 다릅니다. 방금 갱신된 파일을 확인하고 git add apps/api/openapi.json 후 다시 커밋하세요.' >&2
  exit 1
fi

pnpm typecheck --output-logs=errors-only
pnpm test --output-logs=errors-only
