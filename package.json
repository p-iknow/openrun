{
  "name": "@openrun/root",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "storybook": "pnpm --filter @openrun/store-ui storybook",
    "build": "turbo run build build-storybook",
    "openapi:generate": "turbo run openapi:generate --filter=@openrun/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @openrun/api db:migrate",
    "db:seed": "pnpm --filter @openrun/api db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "error"
    }
  }
}
