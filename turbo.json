{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "openapi": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!openapi.json"],
      "outputs": ["openapi.json"]
    },
    "generate": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/openapi.json"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"],
      "passThroughEnv": ["DOCKER_HOST", "TESTCONTAINERS_*"]
    }
  }
}
